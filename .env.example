# Copy to .env for local/host development.
# compose.local.yml supplies service DNS to containers; host apps use 127.0.0.1.
# For production, copy to .env.server and replace every secret before make prod-config.

# --- Identity / naming (set before first deploy; MinIO etc. share hosts) ---
NAME_PREFIX=app
COMPOSE_PROJECT_NAME=app
LOCAL_NETWORK_NAME=app
APP_NETWORK_NAME=app-app
POSTGRES_VOLUME_NAME=app-postgres
REDIS_VOLUME_NAME=app-redis
STORAGE_VOLUME_NAME=app-seaweedfs
MEILI_VOLUME_NAME=app-meilisearch
BACKEND_IMAGE=app-backend:local
FRONTEND_IMAGE=app-frontend:local
SITE_IMAGE=app-site:local


# --- App ---
APP_NAME=api
APP_ENV=development
APP_HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=json

# --- Postgres (host → published port) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=change_me
DB_NAME=app
DB_SSLMODE=disable
POSTGRES_PORT=5432

# --- Redis ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# --- Object storage (SeaweedFS S3 gateway in compose; any S3 works) ---
# Browser never builds object URLs; backend returns logo_url / public_url.
# STORAGE_DRIVER=minio means a self-hosted S3-compatible server; the API
# creates S3_BUCKET on startup when it is missing.
STORAGE_DRIVER=minio
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/app
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=storageadmin
S3_SECRET_KEY=change_me_storage
S3_BUCKET=app
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PORT=9000
SEAWEEDFS_UI_PORT=8888

# --- Centrifugo ---
CENTRIFUGO_ENABLED=true
CENTRIFUGO_PORT=8000
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=app-centrifugo-api-key-change-me
CENTRIFUGO_TOKEN_HMAC_SECRET=app-centrifugo-token-hmac-change-me
CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket
CENTRIFUGO_TOKEN_TTL=1h
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# --- JWT ---
JWT_ACCESS_SECRET=app-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=app-dev-refresh-secret-change-me-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Mail (MailHog locally) ---
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
SMTP_FROM=noreply@localhost
MAIL_FROM_NAME=App
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
ADMINER_PORT=8081

# --- Search (Meilisearch) ---
SEARCH_ENABLED=true
SEARCH_DRIVER=meilisearch
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=app-dev-meili-master-key-change-me
MEILI_INDEX_PREFIX=app
MEILI_PORT=7700

# --- Queue ---
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=10

# Bulk action engine
BULK_SYNC_MAX=50
BULK_ROLLBACK_HOURS=24
QUEUE_WORKER_INPROCESS=true

# --- Tenancy (organizations; docs/design/tenant-core.md) ---
# Off = single-scope app (no /v1/tenant routes).
TENANCY_ENABLED=false
# Let signed-in users create organizations themselves (needs registration on).
TENANCY_SELF_SERVE=false
# Redis cache for org + membership lookups; changes invalidate it at once.
TENANCY_CACHE_TTL=60s

# --- CORS / public URLs ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8080
PUBLIC_FRONTEND_URL=http://localhost:3000
# BFF upstream base — must include /v1 (Go routes are /v1/...).
API_URL=http://127.0.0.1:8080/v1
# Branded site (TEC-729): every organization's site answers on {subdomain}.{host of this URL}.
# Development: `make site-dev` serves http://{subdomain}.localhost:3100.
SITE_BASE_URL=http://localhost:3100

# --- At-rest secret encryption (GitHub App credentials in DB) ---
# 32-byte key, raw or base64. Generate: openssl rand -base64 32
# The backend refuses to start outside development with this example value.
APP_ENCRYPTION_KEY=app-dev-encryption-key-32bytes!!

# --- NextAuth (frontend session layer) ---
AUTH_SECRET=app-dev-auth-secret-change-me-32chars-min
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_ADAPTER_SECRET=app-dev-auth-adapter-secret-change-me

# --- Mobile auth (backend) ---
# App Store / Play review accounts: comma-separated email:code (code >= 6 chars).
# The fixed code signs in (and confirms account deletion) for that email only;
# no email is sent. Leave empty to disable. See backend/docs/auth.md.
AUTH_REVIEW_ACCOUNTS=
# Accepted id_token audiences for native sign-in (comma-separated).
AUTH_APPLE_NATIVE_CLIENT_IDS=
# Google iOS + Android OAuth client ids; the web client id from OAuth settings is accepted too.
AUTH_GOOGLE_NATIVE_CLIENT_IDS=
# Sign in with Apple key (.p8) for code exchange + token revocation on account deletion.
# Optional fallback: prefer uploading the .p8 in Platform → Integrations → Apple
# (stored encrypted in the DB; it wins over these and also generates the web
# client secret). AUTH_APPLE_PRIVATE_KEY is the PEM; "\n" escapes are accepted on one line.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# --- QR sign-in (web QR approved from the mobile app) ---
# Approximate location shown on the phone. Trust edge geo headers (CF-IPCountry /
# CF-IPCity / CF-Region) ONLY behind Cloudflare with "Add visitor location headers"
# on; otherwise a phisher could fake them. Optional MaxMind GeoLite2-City .mmdb path
# as fallback. Neither set = the app shows the IP only. Needs Centrifugo (namespace
# "qrlogin" in deploy/centrifugo/config*.json).
AUTH_QR_TRUST_GEO_HEADERS=false
AUTH_QR_GEOIP_DB=
# Passkey RP ID; defaults to the hostname of PUBLIC_FRONTEND_URL.
AUTH_WEBAUTHN_RP_ID=localhost

# --- Frontend public (baked into the browser bundle) ---
NEXT_PUBLIC_BFF_BASE_URL=/api
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_CENTRIFUGO_URL=ws://127.0.0.1:8000/connection/websocket
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_FALLBACK_LOCALE=en

# --- Web Push (VAPID). Required for closed-browser notifications. ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# --- Error tracking (Sentry protocol; self-hosted tracker) — all optional ---
# Empty DSN = reporting off, nothing else changes. No source map upload and no
# auth token: builds never talk to the tracker.
# Production (compose.prod.yml / Dokploy shares one env across services):
#   BACKEND_SENTRY_DSN  → backend API + worker (as SENTRY_DSN)
#   FRONTEND_SENTRY_DSN → Next.js server, edge and browser (as SENTRY_DSN)
#   SENTRY_ENVIRONMENT  → both (compose default: production)
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Backend only: share of HTTP requests traced (0..1, e.g. 0.1). 0 = off.
SENTRY_TRACES_SAMPLE_RATE=0
# Local dev (no compose): the apps read SENTRY_DSN directly. Empty = off.
SENTRY_DSN=

# --- Payments (iyzico endpoints; merchant keys are per organization, set in the panel) ---
IYZICO_SANDBOX_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_LIVE_BASE_URL=https://api.iyzipay.com

# --- SMS (Netgsm endpoints; usercode / password / header are per organization, set in the panel) ---
NETGSM_LIVE_BASE_URL=https://api.netgsm.com.tr
# Netgsm has no sandbox. Development: point it at `go run ./cmd/netgsm-fake` (http://127.0.0.1:18091).
NETGSM_SANDBOX_BASE_URL=
# Development only: an SMS provider "log" that writes masked log lines instead of sending.
SMS_LOG_PROVIDER=false

# --- WhatsApp (wuzapi gateway; each organization links its own number in the panel) ---
# Production runs wuzapi on the app network (compose.prod.yml). Local: leave empty to use the
# development fake provider (whatsapp_fake), or run wuzapi and point these at it.
WUZAPI_BASE_URL=
WUZAPI_ADMIN_TOKEN=
# The API origin as wuzapi reaches it (webhooks), e.g. http://host.docker.internal:8080
WUZAPI_WEBHOOK_BASE_URL=

# Verified custom site domains (TEC-731)
SITE_DOMAIN_TARGET_HOST=
SITE_DOMAIN_TARGET_IPS=
SITE_DOMAIN_PROVISIONER=manual
SITE_DOMAIN_TRAEFIK_DIR=
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_COMPOSE_ID=
DOKPLOY_SITE_SERVICE=site
DOKPLOY_SITE_PORT=3000
APP_NETWORK_NAME=
