# Production env schema, read by scripts/prod-env.sh.
#
# One managed key per line:  KEY | rule
#   ask:APP_URL         asked once (the only question); everything else derives from it
#   derive:<template>   {APP_HOST} (host of APP_URL) and {KEY} of any key above it are substituted
#   const:<value>       fixed default
#   secret:<kind>:<n>   random value; kind = hex (n bytes), alnum (n chars), b64 (n bytes)
#   vapid:public / vapid:private   Web Push key pair (generated together)
#   empty               optional, left blank for the operator to fill in
#
# Upgrades keep every existing value. Only missing keys are generated, so
# secrets (DB_PASSWORD, APP_ENCRYPTION_KEY, ...) never change once deployed.
#
# Schema changes:
#   bump @version, add new keys at the end of their section,
#   rename with  @rename OLD NEW <version>,  retire with  @remove KEY <version>.
#   Never change the rule of an existing secret: running installs keep theirs anyway.

@version 4

# --- Identity / Docker ---
NAME_PREFIX | const:rentopia
BACKEND_IMAGE | derive:{NAME_PREFIX}-backend:latest
FRONTEND_IMAGE | derive:{NAME_PREFIX}-frontend:latest

# --- Public URLs (from APP_URL) ---
APP_URL | ask:APP_URL
REALTIME_HOST | derive:realtime.{APP_HOST}
AUTH_URL | derive:{APP_URL}
PUBLIC_FRONTEND_URL | derive:{APP_URL}
CORS_ALLOWED_ORIGINS | derive:{APP_URL}
CENTRIFUGO_ALLOWED_ORIGINS | derive:{APP_URL}
CENTRIFUGO_WS_URL | derive:wss://{REALTIME_HOST}/connection/websocket
NEXT_PUBLIC_CENTRIFUGO_URL | derive:wss://{REALTIME_HOST}/connection/websocket
AUTH_WEBAUTHN_RP_ID | derive:{APP_HOST}

# --- Database / cache / search ---
DB_USER | const:rentopia
DB_NAME | const:rentopia
DB_PASSWORD | secret:alnum:32
REDIS_PASSWORD | secret:alnum:32
MEILI_MASTER_KEY | secret:hex:32

# --- Object storage (SeaweedFS S3) ---
S3_BUCKET | const:rentopia
S3_ACCESS_KEY | secret:alnum:20
S3_SECRET_KEY | secret:alnum:40

# --- Auth / crypto ---
JWT_ACCESS_SECRET | secret:hex:32
JWT_REFRESH_SECRET | secret:hex:32
AUTH_SECRET | secret:hex:32
AUTH_ADAPTER_SECRET | secret:hex:32
APP_ENCRYPTION_KEY | secret:b64:32
CENTRIFUGO_API_KEY | secret:hex:24
CENTRIFUGO_TOKEN_HMAC_SECRET | secret:hex:32

# --- Web Push ---
VAPID_PUBLIC_KEY | vapid:public
VAPID_PRIVATE_KEY | vapid:private
VAPID_SUBJECT | derive:mailto:noreply@{APP_HOST}

# --- Product ---
TENANCY_ENABLED | const:true
TENANCY_SELF_SERVE | const:false
LOG_LEVEL | const:info

# --- Mail (fill in to send e-mail) ---
MAIL_FROM | derive:noreply@{APP_HOST}
MAIL_FROM_NAME | const:Rentopia
SMTP_HOST | empty
SMTP_PORT | const:587
SMTP_USERNAME | empty
SMTP_PASSWORD | empty

# --- Error tracking (optional) ---
BACKEND_SENTRY_DSN | empty
FRONTEND_SENTRY_DSN | empty

# --- Payments (TEC-707; merchant keys are per organization, in the panel) ---
IYZICO_SANDBOX_BASE_URL | const:https://sandbox-api.iyzipay.com
IYZICO_LIVE_BASE_URL | const:https://api.iyzipay.com

# --- SMS (TEC-734; Netgsm credentials are per organization, in the panel) ---
# Netgsm has no sandbox: leave the sandbox URL empty in production (sandbox
# accounts then refuse to send). SMS_LOG_PROVIDER is ignored in production.
NETGSM_LIVE_BASE_URL | const:https://api.netgsm.com.tr
NETGSM_SANDBOX_BASE_URL | empty
SMS_LOG_PROVIDER | const:false

# --- WhatsApp (TEC-735; wuzapi on the private app network, one session per organization) ---
# Organizations link their own number in the panel (QR). Pin WUZAPI_IMAGE to a
# tested tag; the admin token creates the per-organization wuzapi users.
WUZAPI_IMAGE | const:asternic/wuzapi:latest
WUZAPI_ADMIN_TOKEN | secret:hex:32
WUZAPI_ENCRYPTION_KEY | secret:alnum:32
